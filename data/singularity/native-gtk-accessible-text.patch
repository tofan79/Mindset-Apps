+        private Pos? position_for_offset(uint offset) {
+            if (doc == null) return null;
+            Pos? last = null;
+            foreach (var p in Story.paragraphs(doc.body)) {
+                uint length = (uint) p.plain_text().char_count();
+                if (offset <= length) return new Pos(p, (int) offset);
+                offset -= length + 1;
+                last = new Pos(p, p.length);
+            }
+            return offset == 0 ? last : null;
+        }
