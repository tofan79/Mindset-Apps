 	if MetadataManager != nil && MetadataManager.Metadata != nil {
+		var found *PropertySchema
+		ambiguous := false
 		for _, class := range MetadataManager.Metadata.Classes {
-			if prop, ok := class.Properties[gtkPropName]; ok {
