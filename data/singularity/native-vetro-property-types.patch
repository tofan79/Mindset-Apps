+			prop, ok := class.Properties[gtkPropName]
+			if !ok {
+				continue
 			}
+			propType := mapGirTypeToPropType(prop.Type)
+			if found == nil {
+				found = &PropertySchema{Type: propType}
+			} else if found.Type != propType {
+				ambiguous = true
+			}
+		}
+		if found != nil && !ambiguous {
+			return found
 		}
