name: "gloview - COPR Auto Build"

on:
  schedule:
    - cron: '0 17 1 * *'   # tiap bulan tgl 1, jam 00.00 WIB (17:00 UTC)
  workflow_dispatch:

env:
  APP_NAME:       "gloview"
  GITHUB_REPO:    "fedsfarm/gloview"
  COPR_PROJECT:   "Mindset-Apps"
  SPEC_FILE:      "specs/gloview.spec"
  FEDORA_BUILD:   "44"

jobs:
  check-and-build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - name: Get upstream latest version
        id: upstream
        run: |
          CMAKELISTS=$(curl -s "https://raw.githubusercontent.com/${{ env.GITHUB_REPO }}/main/CMakeLists.txt")
          VER=$(echo "$CMAKELISTS" | grep -oP 'project\(gloview\s+VERSION\s+"\K[0-9.]+' | head -1)
          [ -z "$VER" ] && { echo "⚠ No version found — skipping."; echo "skip=true" >> $GITHUB_OUTPUT; exit 0; }
          echo "version=$VER" >> $GITHUB_OUTPUT
          echo "▶ Upstream: $VER"

      - name: Get current COPR version
        id: copr
        run: |
          CURRENT=$(curl -s \
            "https://copr.fedorainfracloud.org/api_3/build/list/?ownername=${{ secrets.COPR_USERNAME }}&projectname=${{ env.COPR_PROJECT }}&packagename=${{ env.APP_NAME }}" \
            | jq -r '[.items[] | select(.state == "succeeded") | .source_package.version][0] // "none"')
          CURRENT="${CURRENT%-*}"
          echo "version=$CURRENT" >> $GITHUB_OUTPUT
          echo "▶ COPR: $CURRENT"

      - name: Smart Skip
        id: check
        run: |
          if [ "${{ steps.upstream.outputs.skip }}" = "true" ]; then
            echo "skip=true" >> $GITHUB_OUTPUT
            exit 0
          fi
          UP="${{ steps.upstream.outputs.version }}"
          CP="${{ steps.copr.outputs.version }}"
          if [ "$UP" = "$CP" ]; then
            echo "✅ Up-to-date ($UP), skip."
            echo "skip=true" >> $GITHUB_OUTPUT
          else
            echo "🆕 Update $CP → $UP"
            echo "skip=false" >> $GITHUB_OUTPUT
          fi

      - name: Build gloview.so in Fedora container
        if: steps.check.outputs.skip == 'false'
        run: |
          VER="${{ steps.upstream.outputs.version }}"
          docker run --rm -v "$PWD:/src" \
            registry.fedoraproject.org/fedora:${{ env.FEDORA_BUILD }} \
            bash -c '
              set -eux
              dnf -y install dnf-plugins-core
              dnf -y copr enable lionheartp/Hyprland
              dnf -y install wget cmake gcc-c++ make hyprland-devel mesa-libGL-devel lua-devel pkgconf-pkg-config
              cd /src
              wget -q "https://codeload.github.com/${{ env.GITHUB_REPO }}/tar.gz/refs/heads/main" -O gloview-main.tar.gz
              tar xzf gloview-main.tar.gz
              cd gloview-main
              cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
              cmake --build build -j$(nproc)
              cp build/gloview.so /src/gloview.so
            '
          mkdir -p "gloview-${VER}"
          cp gloview.so "gloview-${VER}/"
          tar -czf "gloview-${VER}.tar.gz" "gloview-${VER}"
          md5sum -b "gloview-${VER}.tar.gz"
          echo "TARBALL=gloview-${VER}.tar.gz" >> $GITHUB_ENV
          echo "RPMVERSION=$VER" >> $GITHUB_ENV

      - name: Install dependencies
        if: steps.check.outputs.skip == 'false'
        run: |
          sudo apt-get update -q
          sudo apt-get install -y rpm build-essential
          pip install copr-cli --quiet

      - name: Build SRPM
        if: steps.check.outputs.skip == 'false'
        id: srpm
        run: |
          VER="${{ env.RPMVERSION }}"
          mkdir -p ~/rpmbuild/{SPECS,SOURCES,SRPMS}
          cp ${{ env.SPEC_FILE }} ~/rpmbuild/SPECS/
          sed -i "s/%{pkg_version}/$VER/g" ~/rpmbuild/SPECS/gloview.spec
          cp "$TARBALL" ~/rpmbuild/SOURCES/
          rpmbuild -bs ~/rpmbuild/SPECS/gloview.spec
          SRPM=$(ls ~/rpmbuild/SRPMS/*.src.rpm)
          echo "path=$SRPM" >> $GITHUB_OUTPUT

      - name: Setup COPR credentials
        if: steps.check.outputs.skip == 'false'
        run: |
          mkdir -p ~/.config
          cat > ~/.config/copr << EOF
          [copr-cli]
          username = ${{ secrets.COPR_USERNAME }}
          login    = ${{ secrets.COPR_LOGIN }}
          token    = ${{ secrets.COPR_TOKEN }}
          copr_url = https://copr.fedorainfracloud.org
          EOF

      - name: Submit to COPR
        if: steps.check.outputs.skip == 'false'
        run: copr-cli build ${{ env.COPR_PROJECT }} ${{ steps.srpm.outputs.path }}